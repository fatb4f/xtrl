{
  "schema_version": "xtrl.pre_contract/v0.2",
  "packet_id": "pkt-loop-0010-denied-promo-recovery-regression",
  "component": "xtrl",
  "repo": "xtrl",
  "base_ref": "origin/main",
  "mode": "loop",
  "budgets": {
    "time_minutes": 60,
    "iteration_budget": 2,
    "diff_budget": { "max_files_changed": 60, "max_lines_changed": 1800 }
  },
  "constraints": {
    "clean_repo_required": true,
    "deny_repo_local_roots": [".codex", ".quint"],
    "allowed_paths": [
      "tools/**",
      "control/**",
      "schemas/**",
      "docs/**",
      "tests/**",
      "README.md"
    ],
    "forbidden_paths": [".git/**"],
    "forbidden_patterns": [
      "subprocess\\.run\\(.*shell\\s*=\\s*True",
      "os\\.system\\(",
      "eval\\(",
      "exec\\("
    ]
  },
  "actions": {
    "replay": ["python", "tools/replay_harness.py"],
    "fuzz": ["python", "tools/fuzz_mutation.py"],
    "test": ["python", "-m", "pytest", "-q", "--junitxml", "evidence/tests.junit.xml"]
  },
  "evidence": {
    "required_files": [
      "evidence/plan.md",
      "evidence/decision.md",
      "evidence/scope.json",
      "evidence/integrity.json",
      "evidence/tests.junit.xml",
      "evidence/regression.md",
      "evidence/events.jsonl",
      "evidence/next_iter_plan.json",
      "evidence/adaptation_policy.json",
      "evidence/replay_report.json",
      "evidence/replay_report.md",
      "evidence/fuzz_mutation_report.json",
      "evidence/fuzz_mutation_report.md",
      "commands.log",
      "summary.md",
      "packet.json",
      "contract.json",
      "exec-prompt.md"
    ]
  },
  "plan_card": {
    "why": "Make denial actionable and regression-proof.",
    "what": "Emit deterministic next_iter_plan + replay/fuzz reports + adaptation policy mapping.",
    "how": "On DENY produce restart plan; run corpus replay + mutation fuzz with stable reason codes.",
    "where": "controller gate + harness",
    "who": "xtrl runner",
    "when": "GATE"
  },
  "inputs": {
    "notes": [
      "Define DENY trigger scope (worker gate vs promote gate) and emit next_iter_plan.json accordingly.",
      "Emit evidence/adaptation_policy.json that maps signals to reason_code + strategy.",
      "Emit corpus replay + mutation fuzz reports with stable reason codes.",
      "Bind failures to deterministic adaptation policy mapping."
    ]
  }
}
