  "plan_card": {
    "why": "Make execution deterministic and non-ambiguous by banning shell wrappers in actions.",
    "what": "Require every action to be an argv vector executed directly; deny bash -lc patterns.",
    "how": "Precheck: validate actions are arrays of strings; reject known shell wrappers; exec uses subprocess without shell.",
