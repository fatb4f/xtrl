{
  "schema_version": "xtrl.pre_contract/v0.2",
  "packet_id": "pkt-loop-0004-gate-decision-reason-codes",
  "component": "xtrl",
  "repo": "xtrl",
  "base_ref": "origin/main",
  "mode": "NORMAL",
  "budgets": {
    "time_minutes": 45,
    "iteration_budget": 2,
    "diff_budget": {
      "max_files_changed": 25,
      "max_lines_changed": 800
