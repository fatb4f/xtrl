    "how": "Gate reads EvidenceCapsule signals; produces decision.json + explain/trace; denial must set next_base_ref pointer.",
    "where": "CHECK/GATE stage outputs under out/<repo_key>/<packet_id>/evidence/",
    "who": "controller gate",
    "when": "GATE"
