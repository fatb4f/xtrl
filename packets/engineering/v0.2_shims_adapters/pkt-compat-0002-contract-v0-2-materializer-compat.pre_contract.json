{
  "actions": {
    "test": [
      "python",
      "-m",
      "pytest",
      "-q"
    ],
    "verify": [
      "python",
      "tools/verify_contract_v0_2.py"
    ]
  },
  "base_ref": "origin/main",
  "budgets": {
    "diff_budget": {
      "max_files_changed": 30,
      "max_lines_changed": 800
    },
    "iteration_budget": 2,
    "time_minutes": 45
  },
  "component": "xtrl-ops",
  "constraints": {
    "allowed_paths": [
      "/home/src404/src/**",
      "/tmp/**"
    ],
    "clean_repo_required": true,
    "deny_repo_local_roots": [
      ".codex",
      ".quint"
    ],
    "forbidden_paths": [
      ".git/**"
    ],
    "forbidden_patterns": [
      "subprocess\\.run\\(.*shell\\s*=\\s*True",
      "os\\.system\\(",
      "eval\\(",
      "exec\\("
    ]
  },
  "evidence": {
    "required_files": [
      "evidence/plan.md",
      "evidence/decision.md",
      "evidence/scope.json",
      "evidence/integrity.json",
      "evidence/tests.junit.xml",
      "evidence/regression.md",
      "commands.log",
      "summary.md",
      "packet.json",
      "contract.json",
      "exec-prompt.md"
    ]
  },
  "inputs": {
    "notes": [
      "This pre_contract defines a compat/reuse-port shim packet.",
      "Keep changes additive; prefer small deterministic helpers under tools/."
    ]
  },
  "mode": "NORMAL",
  "network_policy": {
    "additional_domains": [],
    "allowed_http_methods": [],
    "domain_allowlist_preset": "none",
    "internet_access": "on"
  },
  "packet_id": "pkt-compat-0002-contract-v0-2-materializer-compat",
  "plan_card": {
    "how": "additive shim/adapters + verifier; no backlog refactor",
    "what": "Add legacy\u2192v0.2 contract materializer adapter; always emit v0.2 contract.json for runs",
    "when": "compat/reuse-port stabilization pass (post xtrl-ops v0.2)",
    "where": "tools/packet_generate.py + schemas/contract.schema.json",
    "who": "xtrl controller",
    "why": "Ensure downstream runner/gate always sees a v0.2 contract shape regardless of legacy inputs"
  },
  "repo": "fatb4f/xtrl",
  "schema_version": "xtrl.pre_contract/v0.2"
}
