{
  "actions": {
    "test": [
      "python",
      "-m",
      "pytest",
      "-q"
    ],
    "verify": [
      "python",
      "tools/verify_evidence_v0_2.py"
    ]
  },
  "base_ref": "origin/main",
  "budgets": {
    "diff_budget": {
      "max_files_changed": 30,
      "max_lines_changed": 800
    },
    "iteration_budget": 2,
    "time_minutes": 45
  },
  "component": "xtrl-ops",
  "constraints": {
    "allowed_paths": [
      "/home/src404/src/**",
      "/tmp/**"
    ],
    "clean_repo_required": true,
    "deny_repo_local_roots": [
      ".codex",
      ".quint"
    ],
    "forbidden_paths": [
      ".git/**"
    ],
    "forbidden_patterns": [
      "subprocess\\.run\\(.*shell\\s*=\\s*True",
      "os\\.system\\(",
      "eval\\(",
      "exec\\("
    ]
  },
  "evidence": {
    "required_files": [
      "evidence/plan.md",
      "evidence/decision.md",
      "evidence/scope.json",
      "evidence/integrity.json",
      "evidence/tests.junit.xml",
      "evidence/regression.md",
      "commands.log",
      "summary.md",
      "packet.json",
      "contract.json",
      "exec-prompt.md"
    ]
  },
  "inputs": {
    "notes": [
      "This pre_contract defines a compat/reuse-port shim packet.",
      "Keep changes additive; prefer small deterministic helpers under tools/."
    ]
  },
  "mode": "NORMAL",
  "network_policy": {
    "additional_domains": [],
    "allowed_http_methods": [],
    "domain_allowlist_preset": "none",
    "internet_access": "on"
  },
  "packet_id": "pkt-compat-0003-evidencecapsule-v0-2-emitter-compat",
  "plan_card": {
    "how": "additive shim/adapters + verifier; no backlog refactor",
    "what": "Ensure EvidenceCapsule v0.2 directory tree is always emitted; add adapter to map legacy evidence into required v0.2 files",
    "when": "compat/reuse-port stabilization pass (post xtrl-ops v0.2)",
    "where": "tools/ctrl_evidence.py + tools/evidence/*",
    "who": "xtrl controller",
    "why": "Make runs auditable and binding-compliant; prevent missing evidence from breaking gate"
  },
  "repo": "fatb4f/xtrl",
  "schema_version": "xtrl.pre_contract/v0.2"
}
