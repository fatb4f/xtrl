{
  "allowed_paths": [
    "docs/**",
    "tools/**",
    "tests/**",
    "packets/**",
    "README.md"
  ],
  "area": "engineering",
  "base_ref": "main",
  "branch": "packet/packet-013-backlogmd-install",
  "budgets": {
    "max_changed_files": 10,
    "max_changed_lines": 300
  },
  "evidence": {
    "include_git_diff_patch": false,
    "out_dir": "$CODEX_STATE/xtrl/out"
  },
  "forbidden_outputs": [
    ".codex/**",
    ".quint/**"
  ],
  "github_ops_required": false,
  "net_ops_required": true,
  "network_policy": {
    "additional_domains": [
      "registry.npmjs.org",
      "github.com",
      "api.github.com"
    ],
    "allowed_http_methods": [
      "GET"
    ],
    "domain_allowlist_preset": "custom",
    "internet_access": "on"
  },
  "packet_id": "packet-013-backlogmd-install",
  "repo": "local:xtrl",
  "run": {
    "commands": [
      "NPM_CONFIG_PREFIX=\"$HOME/.local\" npm i -g backlog.md",
      "backlog --help",
      "backlog --version",
      "backlog mcp start --help"
    ],
    "regen_cmd": "",
    "test_cmd": ""
  },
  "worktree_policy": {
    "allow_dirty_globs": [],
    "allow_untracked_globs": [],
    "deny_if_worktree_exists": true,
    "mode": "strict",
    "worktree_root": "$CODEX_STATE/xtrl/worktrees"
  }
}
