{
  "allowed_paths": [
    "backlog/**",
    "backlog.md",
    ".backlog/**",
    "docs/**",
    "packets/**",
    "README.md"
  ],
  "area": "engineering",
  "base_ref": "main",
  "branch": "packet/packet-015-backlogmd-run",
  "budgets": {
    "max_changed_files": 20,
    "max_changed_lines": 1000
  },
  "evidence": {
    "include_git_diff_patch": false,
    "out_dir": "out"
  },
  "forbidden_outputs": [
    ".codex/**",
    ".quint/**"
  ],
  "github_ops_required": false,
  "net_ops_required": false,
  "network_policy": {
    "additional_domains": [],
    "allowed_http_methods": [],
    "domain_allowlist_preset": "none",
    "internet_access": "off"
  },
  "packet_id": "packet-015-backlogmd-run",
  "repo": "local:xtrl",
  "run": {
    "commands": [
      "backlog --help",
      "backlog list --help",
      "backlog board --help",
      "backlog browser --help"
    ],
    "regen_cmd": "",
    "test_cmd": ""
  },
  "worktree_policy": {
    "allow_dirty_globs": [],
    "allow_untracked_globs": [],
    "deny_if_worktree_exists": true,
    "mode": "strict",
    "worktree_root": "$CODEX_STATE/xtrl/worktrees"
  }
}
