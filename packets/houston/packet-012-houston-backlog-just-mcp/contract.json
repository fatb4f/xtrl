{
  "allowed_paths": [
    "templates/Justfile.tmpl",
    "dot_config/codex/just/xtrl.just",
    "dot_config/codex/xtrl/MCP.md",
    "xtrl"
  ],
  "area": "houston",
  "base_ref": "HEAD",
  "branch": "packet/packet-012-houston-backlog-just-mcp",
  "budgets": {
    "max_changed_files": 10,
    "max_changed_lines": 500
  },
  "evidence": {
    "include_git_diff_patch": false,
    "out_dir": "out"
  },
  "forbidden_outputs": [
    ".codex/**",
    ".quint/**"
  ],
  "github": {
    "issue": {
      "body": "",
      "close_on_success": false,
      "comment_on_run": false,
      "ensure": false,
      "labels": [],
      "milestone": "",
      "template": "packet-default.yml",
      "title": "packet-012-houston-backlog-just-mcp"
    },
    "repo": "fatb4f/xtrl"
  },
  "github_ops_required": false,
  "net_ops_required": false,
  "network_policy": {
    "additional_domains": [],
    "allowed_http_methods": [],
    "domain_allowlist_preset": "none",
    "internet_access": "off"
  },
  "packet_id": "packet-012-houston-backlog-just-mcp",
  "repo": "fatb4f/xtrl",
  "run": {
    "commands": [
      "python ./xtrl just render --out /tmp/xtrl.Justfile",
      "just -f /tmp/xtrl.Justfile --list | grep -q 'ctrl\\.backlog\\.hydrate'",
      "just -f /tmp/xtrl.Justfile --list | grep -q 'ctrl\\.backlog\\.sync'",
      "grep -q 'ctrl\\.backlog\\.hydrate' templates/Justfile.tmpl",
      "grep -q 'ctrl\\.backlog\\.sync' templates/Justfile.tmpl"
    ],
    "regen_cmd": "",
    "test_cmd": ""
  },
  "worktree_policy": {
    "allow_dirty_globs": [],
    "allow_untracked_globs": [],
    "deny_if_worktree_exists": true,
    "mode": "strict",
    "worktree_root": "$CODEX_STATE/xtrl/worktrees"
  }
}
